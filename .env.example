# Copia para .env.local
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require"
AUTH_SECRET="gera-com-openssl-rand-base64-32"
# Utilizadores são geridos no painel /utilizadores (só ADMIN).
# O primeiro admin é criado via: npm run db:seed -- --email=EMAIL --password='SENHA_FORTE' [--nome='Nome']
# Push (gera com: npx web-push generate-vapid-keys):
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@lk-aluguel.ao"
# Cron (Vercel Cron envia como Authorization: Bearer; gera com: openssl rand -hex 32):
CRON_SECRET=""
